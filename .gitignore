# Public source allowlist. Everything else is local-only and remains on disk.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/HANDOFF.md
!/THIRD_PARTY_NOTICES.md
!/build.ps1
!/global.json
!/docs/
!/config/
!/tools/
!/Development/
/Development/*
!/Development/loader-src/
/Development/loader-src/*
!/Development/loader-src/DroneRacingGenesis.Plugin/
!/Development/loader-src/DroneRacingGenesisLoader/
!/Development/loader-src/DroneRacingGenesisLoader.Tests/
!/Development/loader-src/IOCompatibility/
!/Development/loader-src/NativeUnity/
**/bin/
**/obj/
**/.vs/
**/.venv*/
**/__pycache__/
**/fixture */
*.exe
*.dll
*.pdb
*.obj
*.lib
*.exp
*.ilk
*.dmp
*.log
*.tmp
*.user
*.suo
.env
.env.*

# Retired Frida-era research stays local, including old hook manifests.
/Development/loader-src/DroneRacingGenesis.Plugin/*.py
/Development/loader-src/DroneRacingGenesis.Plugin/*.js
/Development/loader-src/DroneRacingGenesis.Plugin/*.json
/Development/loader-src/DroneRacingGenesis.Plugin/HOOKS.md
